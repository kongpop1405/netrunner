# Machine-specific settings. Copy to `.env` and fill in — `.env` is git-ignored,
# never commit it. Read by main.py (python-dotenv) and every run_*.bat.
# Precedence: CLI flag > .env > config JSON.

# Path to the adb binary. LDPlayer bundles one; leave as `adb` if it's on PATH.
ADB_PATH=C:\LDPlayer\LDPlayer14\adb.exe

# Your LDPlayer instance's adb address. Port formula: 5555 + 2*instance_index
# (index 0 -> 5555, index 1 -> 5557, ...). Overrides the config's "device".
NETRUNNER_DEVICE=127.0.0.1:5555

# Optional: Discord webhook for crash/livelock alerts (channel Settings ->
# Integrations -> Webhooks). Leave empty to disable alerts.
DISCORD_WEBHOOK_URL=
