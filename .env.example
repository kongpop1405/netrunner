# OPTIONAL overrides — everything below is auto-detected; most machines need no .env at all.
# To override: copy to `.env` and fill in. `.env` is git-ignored, never commit it.
# Precedence: CLI flag > .env > auto-detect > config JSON.

# adb binary. Auto-detect order: `adb` on PATH, then newest C:\LDPlayer\LDPlayer*\adb.exe.
#ADB_PATH=C:\LDPlayer\LDPlayer14\adb.exe

# LDPlayer instance address. Auto-detect scans ports 5555/5557/5559/5561
# (5555 + 2*instance_index) and picks the one running instance.
# Set this ONLY when several instances run at once and the bot must pick one.
#NETRUNNER_DEVICE=127.0.0.1:5555

# Discord webhook for crash/livelock alerts (channel Settings -> Integrations ->
# Webhooks). Leave unset to disable alerts.
#DISCORD_WEBHOOK_URL=
